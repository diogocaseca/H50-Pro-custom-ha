diff --git a/h50console/decoders.py b/h50console/decoders.py
index a139c61..66b8391 100644
--- a/h50console/decoders.py
+++ b/h50console/decoders.py
@@ -97,6 +97,27 @@ def base_status(raw) -> dict:
 
 # P2 resolvido em 11/10: 1 = secando (2/90 = minutos restantes), 2 = esvaziando o pó, 3 = lavando o mop
 BASE_MODE = {0: "Ociosa", 1: "Secando", 2: "Esvaziando o pó", 3: "Lavando o mop"}
+DRYING_MINUTES = {1: 120, 2: 180, 3: 240}      # 2/31 Duração da secagem: 2 h, 3 h, 4 h
+
+
+def _num(v):
+    return v if isinstance(v, (int, float)) and not isinstance(v, bool) else None
+
+
+def drying_percent(values: dict) -> int | None:
+    """% da secagem dos mops. O H50 Pro deixa o 2/88 em 0 durante a secagem e só informa os minutos restantes
+    (2/90), então a conta usa a duração escolhida (2/31). Se o 2/88 vier preenchido, vale ele. Fora da secagem: 0;
+    secando sem dados para calcular: None."""
+    reported = _num(values.get("2/88"))
+    if reported and reported > 0:
+        return reported
+    left = _num(values.get("2/90"))
+    if base_status(values.get("2/18"))["mode"] != 1 and not (left and left > 0):
+        return 0
+    total = DRYING_MINUTES.get(values.get("2/31"))
+    if not total or left is None:
+        return None
+    return max(0, min(100, round((total - left) * 100 / total)))
 
 
 def current_config(raw) -> dict:
diff --git a/h50console/static/app.js b/h50console/static/app.js
index 88347df..d31e080 100644
--- a/h50console/static/app.js
+++ b/h50console/static/app.js
@@ -89,6 +89,13 @@
   const V = (k) => state?.values?.[k];
   const CLEANING = new Set([4, 10, 16, 17]), PAUSED = new Set([5, 18]), RETURNING = new Set([6, 19, 20, 21, 24]);
   const BASE_MODE = { 0: "", 1: "Secando", 2: "Esvaziando o pó", 3: "Lavando o mop" };
+  const DRYING_MINUTES = { 1: 120, 2: 180, 3: 240 };   // 2/31 Duração da secagem
+  // % da secagem: o H50 Pro deixa o 2/88 em 0; calcula pela duração (2/31) e minutos restantes (2/90). Ver decoders.drying_percent.
+  function dryingPct() {
+    if (V("2/88") > 0) return V("2/88");
+    const total = DRYING_MINUTES[V("2/31")], left = V("2/90");
+    return total && typeof left === "number" ? Math.max(0, Math.min(100, Math.round((total - left) * 100 / total))) : null;
+  }
 
   async function loadState() { state = await api("GET", "/api/state"); return state; }
   async function loadSettings() { settings = await api("GET", "/api/settings"); return settings; }
@@ -120,7 +127,9 @@
       out.push(chip(`${p >= 0 ? p + " % · " : ""}${area.toLocaleString("pt-BR", { maximumFractionDigits: 1 })} m² · ${fmtDur(V("2/7"))}`));
     }
     if (base.mode) {
-      const extra = base.mode === 1 && V("2/90") ? ` · faltam ${fmtMin(V("2/90"))}` : base.progress ? ` · ${base.progress} %` : "";
+      const dry = base.mode === 1 ? dryingPct() : null;
+      const extra = base.mode === 1 && V("2/90") ? `${dry != null ? ` · ${dry} %` : ""} · faltam ${fmtMin(V("2/90"))}`
+        : base.progress ? ` · ${base.progress} %` : "";
       out.push(chip(BASE_MODE[base.mode] + extra));
     }
     if (V("3/1") != null) out.push(chip(`${V("3/1")} %` + (V("3/2") === 1 ? " · Carregando" : ""), V("3/1") < 20 ? "warn" : ""));
