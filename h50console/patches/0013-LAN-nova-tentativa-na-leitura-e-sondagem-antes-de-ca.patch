+                    with self._lan_timeout(LAN_READ_TIMEOUT):
+                        return self.lan_client.send(method, params, retry=max(retry, 1))
                 return self.lan_client.send(method, params, retry=retry)
             except MiioError:
                 if self.cloud_client is None:
