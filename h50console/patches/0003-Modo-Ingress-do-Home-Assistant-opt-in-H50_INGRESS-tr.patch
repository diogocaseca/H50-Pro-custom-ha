@@ -370,3 +371,74 @@ class AuthHttp(unittest.TestCase):
 
 if __name__ == "__main__":
     unittest.main()
+
+
+GW, OTHER = "127.0.0.3", "127.0.0.2"     # no Linux todo o 127/8 é loopback: dá para escolher o IP de origem do socket
+
+
+@unittest.skipUnless(sys.platform.startswith("linux"), "precisa de 127.0.0.2/127.0.0.3 como origem (Linux)")
+class IngressHttp(unittest.TestCase):
+    """Modo Ingress (app do Home Assistant). O gateway real é 172.30.32.2; aqui ele é simulado por 127.0.0.3."""
+
+    def server(self, **kw):
+        return Server(self, ingress=True, ingress_gateway=GW, **kw)
+
+    def test_gateway_is_admin_without_cookie_and_can_be_framed(self):
+        s = self.server()
+        st, d, r = s.req("GET", "/api/robots", source=GW)
+        self.assertEqual(st, 200)
+        self.assertEqual(r.getheader("X-Frame-Options"), "SAMEORIGIN")
+        self.assertIn("frame-ancestors 'self'", r.getheader("Content-Security-Policy"))
+        self.assertEqual(s.req("GET", "/", source=GW)[0], 200)
+        _, st, _ = s.req("GET", "/api/auth/status", source=GW)
+        self.assertEqual((st["authenticated"], st["role"], st["setup_required"], st["ingress"]), (True, "admin", False, True))
+        st, _, _ = s.req("POST", "/api/auth/viewer", {"password": "somente-leitura-1"}, headers={"X-H50": "1"}, source=GW)
+        self.assertEqual(st, 200)
+
+    def test_other_origins_still_need_the_password_and_cannot_frame(self):
+        s = self.server()
+        for src in (OTHER, "127.0.0.1"):
+            st, body, r = s.req("GET", "/api/robots", source=src, headers={"X-Forwarded-For": "172.30.32.2"})
+            self.assertEqual((st, body["login"]), (401, True), src)
+            self.assertEqual(r.getheader("X-Frame-Options"), "DENY")
+            self.assertIn("frame-ancestors 'none'", r.getheader("Content-Security-Policy"))
+            _, st, _ = s.req("GET", "/api/auth/status", source=src)
+            self.assertNotIn("ingress", st)
+            self.assertTrue(st["setup_required"])
+        self.assertEqual(s.req("GET", "/", source=OTHER)[0], 302)
+
+    def test_ingress_needs_the_real_socket_ip(self):
+        s = Server(self, ingress=True, trust_proxy=True)       # gateway padrão (172.30.32.2); X-Forwarded-For não vale
+        st, _, _ = s.req("GET", "/api/robots", headers={"X-Forwarded-For": "172.30.32.2"})
+        self.assertEqual(st, 401)
+
+    def test_csrf_from_gateway_accepts_the_ha_origin_only(self):
+        s = self.server()
+        ha = {"X-H50": "1", "Host": "172.30.32.1:8050", "X-Forwarded-Host": "ha.local:8123"}
+        st, _, _ = s.req("POST", "/api/robots", {}, headers={**ha, "Origin": "http://ha.local:8123"}, source=GW)
+        self.assertNotEqual(st, 403)
+        st, _, _ = s.req("POST", "/api/robots", {}, headers={**ha, "Origin": "http://mal.example"}, source=GW)
+        self.assertEqual(st, 403)
+        st, _, _ = s.req("POST", "/api/robots", {}, headers={**ha, "X-H50": ""}, source=GW)
+        self.assertEqual(st, 403)
+        # fora do gateway, X-Forwarded-Host não amplia nada
+        cookie = s.login_cookie()
+        st, _, _ = s.req("POST", "/api/robots", {}, cookie=cookie, source=OTHER,
+                         headers={**ha, "Host": f"127.0.0.1:{s.port}", "Origin": "http://ha.local:8123"})
+        self.assertEqual(st, 403)
+
+    def test_ingress_only_refuses_direct_access_but_not_loopback(self):
+        s = self.server(ingress_only=True)
+        st, body, _ = s.req("GET", "/login.html", source=OTHER)
+        self.assertEqual(st, 403)
+        self.assertIn("Home Assistant", body["error"])
+        self.assertEqual(s.req("GET", "/api/robots", source=GW)[0], 200)
+        self.assertEqual(s.req("GET", "/api/auth/status")[0], 200)              # loopback (healthcheck)
+        self.assertEqual(s.req("GET", "/api/robots")[0], 401)                   # ...mas continua exigindo senha
+
+    def test_without_ingress_nothing_changes(self):
+        s = Server(self, ingress_gateway=GW)                       # mesmo IP, modo desligado: é um cliente qualquer
+        st, _, r = s.req("GET", "/api/robots", source=GW)
+        self.assertEqual(st, 401)
+        self.assertEqual(r.getheader("X-Frame-Options"), "DENY")
+        self.assertIn("frame-ancestors 'none'", r.getheader("Content-Security-Policy"))
