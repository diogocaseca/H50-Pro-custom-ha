+"""TEMPORÁRIO (app do Home Assistant, patch 0006): log das limpezas para estudar as rotinas com modos diferentes por
+cômodo. Junta, com os valores completos, o que o painel já guardou: as limpezas do Histórico, as mudanças de propriedade
+em volta de cada uma, todo 2/40 do período e os comandos enviados. Só lê o banco; não manda nada ao robô.
+Sai do app quando essa tarefa terminar.
+"""
+
+from __future__ import annotations
+
+import json
+from datetime import datetime, timedelta, timezone
+
+from . import catalog
+from .store import Store, iso, utcnow
+
+DAYS = (7, 30, 90)
+BEFORE_S = 120                    # mudanças de 2 min antes do início
+AFTER_S = 15 * 60                 # até 15 min depois do fim (volta, lavagem dos mops, início da secagem)
+SKIP = ("3/1", "10/1", "10/2")    # bateria e índices do mapa: só volume, nada sobre a rotina
+MAX_ROWS = 20000
+
+
+def _iso(epoch: int) -> str:
+    return iso(datetime.fromtimestamp(epoch, timezone.utc))
+
+
+def _name(key: str) -> str:
+    return catalog.PROPS[key].name if key in catalog.PROPS else ""
+
+
+def _changes(store: Store, start: str, end: str, skip=SKIP, prop: str | None = None) -> list[dict]:
+    where, args = ["ts >= ?", "ts <= ?"], [start, end]
+    if prop:
+        where.append("prop = ?")
+        args.append(prop)
+    elif skip:
+        where.append(f"prop NOT IN ({','.join('?' * len(skip))})")
+        args += list(skip)
+    rows = store._query(f"SELECT ts, prop, old_value, new_value FROM prop_change WHERE {' AND '.join(where)} "
+                        "ORDER BY id LIMIT ?", (*args, MAX_ROWS))
+    return [{"ts": r["ts"], "prop": r["prop"], "name": _name(r["prop"]), "old": r["old_value"], "new": r["new_value"]}
+            for r in rows]
+
+
+def _commands(store: Store, start: str, end: str) -> list[dict]:
+    return store._query("SELECT * FROM command_log WHERE ts >= ? AND ts <= ? ORDER BY id", (start, end))
+
+
+def build(store: Store, snapshot: dict, days: int, now: datetime | None = None) -> dict:
+    now = now or utcnow()
+    if days not in DAYS:
+        raise ValueError(f"período inválido: use {', '.join(map(str, DAYS))} dias")
+    since = now - timedelta(days=days)
+    since_iso, now_iso = iso(since), iso(now)
+    cleanings = []
+    for c in reversed(store.cleanings(start=int(since.timestamp()))):          # da mais antiga para a mais nova
+        end = c["stime"] + (c["duration_s"] or 0)
+        w0, w1 = _iso(c["stime"] - BEFORE_S), _iso(end + AFTER_S)
+        cleanings.append({
+            "start": _iso(c["stime"]), "duration_s": c["duration_s"], "area_m2": c["area_m2"],
+            "type": c["sweep_type"], "type_label": catalog.label("2/5", c["sweep_type"]) if c["sweep_type"] else None,
+            "rooms": c["rooms"], "label": c["raw_label"], "source": c["source"],
+            "window": [w0, w1], "changes": _changes(store, w0, w1), "commands": _commands(store, w0, w1)})
+    return {
+        "about": "Log temporário do H50 Console para estudar as rotinas com modos diferentes por cômodo. "
+                 "Horários em UTC.",
+        "generated_at": now_iso, "days": days, "since": since_iso,
+        "current": {k: {"name": _name(k), "value": v} for k, v in sorted(snapshot.items()) if k in catalog.PROPS},
+        "rooms": [{"map_uid": r["map_uid"], "id": r["id"], "name": r["name"]} for r in store.rooms()],
+        "cleanings": cleanings,
+        "all_2_40": _changes(store, since_iso, now_iso, prop="2/40"),
+        "all_2_42": _changes(store, since_iso, now_iso, prop="2/42"),
+        "commands": _commands(store, since_iso, now_iso),
+    }
+
+
+def export(store: Store, snapshot: dict, days: int) -> tuple[bytes, str]:
+    data = build(store, snapshot, days)
+    name = f"h50-log-limpezas-{datetime.now().strftime('%Y%m%d-%H%M')}.json"
+    return json.dumps(data, ensure_ascii=False, indent=1, default=str).encode("utf-8"), name
