@@ -0,0 +1,68 @@
+"""TEMPORÁRIO (patch 0006 do app): log das limpezas em Diagnóstico."""
+
+import json
+import tempfile
+import unittest
+from datetime import datetime, timedelta, timezone
+
+from h50console.fleet import Fleet, RobotConfig
+from h50console.hub import Hub
+from h50console.web import ApiError, Raw
+
+from .fake import FakeClient
+
+DID = "1000000001"
+ROUTINE = ('{"user_define":{"id":1788583425,"name":"Cômodos e cozin bife","user_data":[["mode","mop"],'
+           '[1,1],[3,3]]},"rooms":[3,7]}')
+
+
+class CleaningLog(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.fleet = Fleet(tmp.name, None, client_factory=lambda cfg: FakeClient({"2/2": 2}), start_threads=False)
+        self.addCleanup(self.fleet.stop_all)
+        self.robot = self.fleet.add(RobotConfig(id="", name="Rex", did=DID), start=False)
+        self.hub = Hub(self.fleet, None)
+        st = self.robot.store
+        now = datetime.now(timezone.utc).replace(microsecond=0)
+        self.start = now - timedelta(days=2)
+        st.upsert_cleaning(int(self.start.timestamp()), 600, 20.5, 7, "derived", rooms=[3, 7],
+                           raw_label="custom:Cômodos e cozin bife")
+        st.save_changes({"2/40": (None, ROUTINE), "2/4": (1, 3), "3/1": (90, 89)}, ts=self.start + timedelta(seconds=30))
+        st.save_changes({"2/40": (ROUTINE, "{}")}, ts=self.start + timedelta(seconds=650))
+        st.save_changes({"2/2": (2, 9)}, ts=self.start + timedelta(hours=3))               # fora da janela
+        st.save_changes({"2/40": (None, "{}")}, ts=now - timedelta(days=40))               # fora dos 30 dias
+        st.log_command("ui", "action:2/16", [3], 0, 40)
+
+    def get(self, days="30"):
+        return self.hub.dispatch("GET", "/api/r/rex/debug/cleaning-log.json", {"days": [days]}, None)
+
+    def test_exports_each_cleaning_with_full_values(self):
+        out = self.get()
+        self.assertIsInstance(out, Raw)
+        self.assertTrue(out.filename.startswith("h50-log-limpezas-") and out.filename.endswith(".json"))
+        data = json.loads(out.data)
+        self.assertEqual(data["days"], 30)
+        [c] = data["cleanings"]
+        self.assertEqual(c["label"], "custom:Cômodos e cozin bife")
+        self.assertEqual(c["rooms"], [3, 7])
+        props = [ch["prop"] for ch in c["changes"]]
+        self.assertEqual(props.count("2/40"), 2)
+        self.assertIn("2/4", props)
+        self.assertNotIn("3/1", props)                                     # bateria fica de fora
+        self.assertNotIn("2/2", props)                                     # 3 h depois: fora da janela
+        self.assertEqual(next(ch["new"] for ch in c["changes"] if ch["prop"] == "2/40"), ROUTINE)  # sem cortar
+        self.assertEqual(len(data["all_2_40"]), 2)                         # a de 40 dias atrás não entra
+        self.assertEqual(data["commands"][0]["command"], "action:2/16")
+        self.assertIsInstance(data["current"], dict)
+
+    def test_ninety_days_reaches_older_changes_and_bad_period_is_refused(self):
+        self.assertEqual(len(json.loads(self.get("90").data)["all_2_40"]), 3)
+        with self.assertRaises(ApiError) as e:
+            self.get("365")
+        self.assertEqual(e.exception.status, 400)
+
+
+if __name__ == "__main__":
+    unittest.main()
