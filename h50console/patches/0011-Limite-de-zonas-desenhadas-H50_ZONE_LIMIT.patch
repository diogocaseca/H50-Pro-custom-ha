diff --git a/h50console/zones.py b/h50console/zones.py
index 998c0af..0ecd57f 100644
--- a/h50console/zones.py
+++ b/h50console/zones.py
@@ -7,6 +7,7 @@ por rotina, em app_setting, porque o prop_change é apagado pela retenção.
 
 from __future__ import annotations
 
+import os
 import secrets
 
 from . import catalog, decoders
@@ -18,6 +19,20 @@ MAX_SAVED = 30
 MAX_NAME = 40
 
 
+def draw_limit() -> int:
+    """Quantos retângulos dá para desenhar por limpeza ou por zona salva (H50_ZONE_LIMIT, 1 a 10; padrão 10).
+    Não vale para as rotinas do app Xiaomi Home nem para zonas salvas antes de baixar o limite."""
+    try:
+        return min(decoders.ZONE_MAX_COUNT, max(1, int(os.environ.get("H50_ZONE_LIMIT", decoders.ZONE_MAX_COUNT))))
+    except ValueError:
+        return decoders.ZONE_MAX_COUNT
+
+
+def check_count(rects) -> None:
+    if isinstance(rects, list) and len(rects) > draw_limit():
+        raise ZoneError(f"no máximo {draw_limit()} zona(s) por limpeza")
+
+
 class ZoneError(ValueError):
     """Pedido inválido (vira 400) ou conflito de nome (vira 409, ver `conflict`)."""
 
@@ -107,6 +122,7 @@ def check_name(name, store: Store, routine_names: list[str], ignore_id: str | No
 def add(store: Store, name, rects, routine_names: list[str]) -> dict:
     name = check_name(name, store, routine_names)
     decoders.zone_param(rects)                                       # valida (ValueError -> 400)
+    check_count(rects)
     zones = saved(store)
     if len(zones) >= MAX_SAVED:
         raise ZoneError(f"limite de {MAX_SAVED} zonas salvas")
