+            groups = self.headers.get_all("X-Remote-User-Groups") or []
+            names = self.headers.get_all("X-Remote-User-Name") or []
+            if len(groups) > 1 or len(names) > 1:       # cabeçalho repetido: tentativa de forjar; nunca é admin
+                return ingress_others
+            if groups and "system-admin" in {g.strip() for g in groups[0].split(",")}:
+                return "admin"
+            if names and names[0].strip().casefold() in ingress_admins:
+                return "admin"
+            return ingress_others
