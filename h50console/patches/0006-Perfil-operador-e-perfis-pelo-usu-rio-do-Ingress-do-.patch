+        def _gateway_role_of_headers(self) -> str:
+            """Perfil de quem chega pelo Ingress. O Supervisor manda o usuário do HA em X-Remote-User-* (e apaga cópias
+            vindas do navegador). Admin do HA (grupo system-admin) ou listado em H50_INGRESS_ADMINS: administrador; os
+            demais: H50_INGRESS_OTHERS. Sem essa variável, todos são administradores (comportamento anterior)."""
+            if not ingress_others:
