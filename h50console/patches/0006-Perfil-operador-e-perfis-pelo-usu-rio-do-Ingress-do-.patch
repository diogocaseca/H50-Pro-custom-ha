diff --git a/tests/test_auth.py b/tests/test_auth.py
index 5ac30a2..fef2ed0 100644
--- a/tests/test_auth.py
+++ b/tests/test_auth.py
@@ -473,3 +473,98 @@ class IngressHttp(unittest.TestCase):
         self.assertEqual(st, 401)
         self.assertEqual(r.getheader("X-Frame-Options"), "DENY")
         self.assertIn("frame-ancestors 'none'", r.getheader("Content-Security-Policy"))
+
+
+@unittest.skipUnless(sys.platform.startswith("linux"), "precisa de 127.0.0.2/127.0.0.3 como origem (Linux)")
+class IngressRoles(unittest.TestCase):
+    """Perfis pelo Ingress: admin do HA ou listado em H50_INGRESS_ADMINS = administrador; os demais = operador."""
+
+    def setUp(self):
+        self.s = Server(self, ingress=True, ingress_gateway=GW, ingress_admins=("Caseca",), ingress_others="operator")
+
+    def req(self, method, path, user=None, groups=None, body=None, raw_headers=(), source=GW):
+        c = http.client.HTTPConnection("127.0.0.1", self.s.port, timeout=5, source_address=(source, 0))
+        c.putrequest(method, path, skip_host=True)
+        headers = [("Host", f"127.0.0.1:{self.s.port}"), ("X-H50", "1")]
+        if user is not None:
+            headers.append(("X-Remote-User-Name", user))
+        if groups is not None:
+            headers.append(("X-Remote-User-Groups", groups))
+        data = json.dumps(body).encode() if body is not None else b""
+        if method != "GET":
+            headers += [("Content-Type", "application/json"), ("Content-Length", str(len(data)))]
+        for k, v in [*headers, *raw_headers]:
+            c.putheader(k, v)
+        c.endheaders(data or None)
+        r = c.getresponse()
+        raw = r.read()
+        c.close()
+        try:
+            return r.status, json.loads(raw)
+        except ValueError:
+            return r.status, raw
+
+    def role(self, **kw):
+        st, body = self.req("GET", "/api/auth/status", **kw)
+        self.assertEqual(st, 200)
+        return body["role"]
+
+    def test_who_is_admin(self):
+        self.assertEqual(self.role(user="caseca"), "admin")                         # lista de admins, sem caixa
+        self.assertEqual(self.role(user="maria", groups="system-users,system-admin"), "admin")   # grupo do HA
+        self.assertEqual(self.role(user="maria", groups="system-users"), "operator")
+        self.assertEqual(self.role(user="maria"), "operator")
+        self.assertEqual(self.role(), "operator")                                   # sem usuário: nunca admin
+        _, st = self.req("GET", "/api/auth/status", user="maria")
+        self.assertEqual(st["ingress_user"], "maria")
+        self.assertEqual(self.req("POST", "/api/robots", user="caseca", body={})[0] != 403, True)
+
+    def test_repeated_headers_are_never_admin(self):
+        self.assertEqual(self.role(user="maria", raw_headers=[("X-Remote-User-Name", "caseca")]), "operator")
+        self.assertEqual(self.role(user="caseca", raw_headers=[("x-remote-user-name", "caseca")]), "operator")
+        self.assertEqual(self.role(user="maria", groups="system-users",
+                                   raw_headers=[("X-Remote-User-Groups", "system-admin")]), "operator")
+
+    def test_user_headers_only_count_from_the_gateway(self):
+        st, _ = self.req("GET", "/api/robots", user="caseca", groups="system-admin", source=OTHER)
+        self.assertEqual(st, 401)
+
+    def test_operator_commands_the_robot_but_does_not_configure(self):
+        allowed = [("POST", "/api/r/sala/actions/start"), ("POST", "/api/actions/dust"), ("POST", "/api/r/sala/actions/home"),
+                   ("POST", "/api/r/sala/clean/rooms"), ("POST", "/api/r/sala/clean/custom/2"),
+                   ("POST", "/api/r/sala/cloud/map"), ("PUT", "/api/r/sala/settings/2-9"), ("PUT", "/api/settings/2-4"),
+                   ("PUT", "/api/r/sala/settings/2-83"), ("GET", "/api/r/sala/state"), ("GET", "/api/robots")]
+        blocked = [("POST", "/api/robots"), ("DELETE", "/api/robots/sala"), ("PUT", "/api/robots/sala"),
+                   ("PUT", "/api/r/sala/settings/2-32"), ("PUT", "/api/r/sala/settings/11-2"),
+                   ("POST", "/api/r/sala/actions/build-map"), ("POST", "/api/r/sala/actions/try-listen"),
+                   ("POST", "/api/r/sala/raw/get"), ("POST", "/api/r/sala/consumables/filter/reset"),
