From dd328ab75106260936a3d09c3efe0f10209c00c6 Mon Sep 17 00:00:00 2001
From: Diogo Caseca <diogofcaseca@gmail.com>
Date: Thu, 22 Oct 2026 23:11:08 -0300
Subject: [PATCH] Nuvem: servidor fixo opcional (H50_CLOUD_COUNTRY)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Contas com aparelhos em servidores diferentes: o painel fica no primeiro
servidor que tem algum aparelho (geralmente us) e não acha o robô que está em
outro, então o mapa e o cadastro pela conta falham. Com H50_CLOUD_COUNTRY
(us, de, sg, cn, ru, i2) todas as chamadas vão só para esse servidor.
Vazio ou auto: nada muda.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 h50console/__main__.py  |  4 ++-
 h50console/cloud.py     | 23 +++++++++----
 h50console/config.py    |  8 ++++-
 tests/test_transport.py | 73 +++++++++++++++++++++++++++++++++++++++++
 4 files changed, 99 insertions(+), 9 deletions(-)

diff --git a/h50console/__main__.py b/h50console/__main__.py
index 381e54a..7c466d5 100644
--- a/h50console/__main__.py
+++ b/h50console/__main__.py
@@ -33,7 +33,7 @@ def _passphrase(confirm: bool = False) -> str:
 
 
 def _fleet(cfg: Config, start_threads: bool) -> Fleet:
-    cloud = CloudService(cfg.data_dir / "cloud-session.json", cfg.data_dir / "map")
+    cloud = CloudService(cfg.data_dir / "cloud-session.json", cfg.data_dir / "map", country=cfg.cloud_country)
     fleet = Fleet(cfg.data_dir, cloud, timeout=cfg.timeout, start_threads=start_threads)
     fleet.load(seed=cfg.seed())
     return fleet
@@ -60,6 +60,8 @@ def serve(cfg: Config) -> int:
     names = ", ".join(f"{r.cfg.name} ({r.cfg.transport})" for r in fleet.robots.values()) or "nenhum (cadastre na interface)"
     log.info("H50 Console %s | dados em %s | robôs: %s", __version__, cfg.data_dir, names)
     log.info("painel em http://%s:%s  (Ctrl+C para sair)", cfg.host, cfg.port)
+    if cfg.cloud_country:
+        log.info("nuvem Xiaomi: servidor fixo '%s' (H50_CLOUD_COUNTRY)", cfg.cloud_country)
     if cfg.ingress:
         log.info("modo Ingress (Home Assistant): pedidos do gateway %s entram sem senha%s", INGRESS_GATEWAY,
                  "; acesso direto DESLIGADO" if cfg.ingress_only else "; acesso direto exige a senha")
